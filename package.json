{
    "name": "node-red-contrib-azure-iot-edge-kpm",
    "version": "1.0.0-beta3",
    "author": {
        "name": "Ken Martin",
        "email": "kmartin@hydraflexinc.com",
        "url": "https://github.com/kpm-at-hfi/node-red-contrib-azure-iot-edge-kpm"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/kpm-at-hfi/node-red-contrib-azure-iot-edge-kpm"
    },
    "license": "MIT",
    "description": "Module to connect to and interact with Azure IoT Edge using Node-Red",
    "packageManager": "npm@10.9.4",
    "bundleDependencies": [],
    "dependencies": {
        "azure-iot-device": "1.18.4",
        "azure-iot-device-mqtt": "1.16.4"
    },
    "deprecated": false,
    "engines": {
        "node": ">=22 <26"
    },
    "scripts": {
        "lint": "node --check azure-iot-edge-module-client.js && node --check azure-iot-edge-device-client.js",
        "test": "node --test --test-concurrency=1 test/*.test.js",
        "test:package": "node test/package-smoke.js"
    },
    "devDependencies": {
        "node-red": "4.1.14",
        "node-red-node-test-helper": "0.3.6"
    },
    "keywords": [
        "node-red",
        "Azure",
        "Azure IoT Edge"
    ],
    "node-red": {
        "version": ">=4 <5",
        "nodes": {
            "moduleclient": "azure-iot-edge-module-client.js",
            "moduletwin": "azure-iot-edge-module-client.js",
            "moduleinput": "azure-iot-edge-module-client.js",
            "moduleoutput": "azure-iot-edge-module-client.js",
            "modulemethod": "azure-iot-edge-module-client.js",
            "deviceclient": "azure-iot-edge-device-client.js"
        }
    }
}
